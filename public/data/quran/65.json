ڑھ جائے اس نے یقیناً اپنے اوپر ﻇلم کیا[7]، تم نہیں جانتے شاید اس کے بعد اللہ تعالیٰ کوئی نئی بات پیدا کر دے.[8]"},{"a":2,"w":[{"t":"فَإِذَا","s":[["فَ","P","REM|PREF|LEM:ف"],["إِذَا","N","T|LEM:إِذا"]],"g":"Then when","tr":"fa-idhā"},{"t":"بَلَغْنَ","s":[["بَلَغْ","V","PERF|VF:1|ROOT:بلغ|LEM:بَلَغَ|3FP"],["نَ","N","PRON|SUFF|3FP"]],"g":"they have reached","tr":"balaghna"},{"t":"أَجَلَهُنَّ","s":[["أَجَلَ","N","ROOT:أجل|LEM:أَجَل|M|ACC"],["هُنَّ","N","PRON|SUFF|3FP"]],"g":"their term","tr":"ajalahunna"},{"t":"فَأَمْسِكُوهُنَّ","s":[["فَ","P","RSLT|PREF|LEM:ف"],["أَمْسِكُ","V","IMPV|VF:4|ROOT:مسك|LEM:أَمْسَكَ|2MP"],["و","N","PRON|SUFF|2MP"],["هُنَّ","N","PRON|SUFF|3FP"]],"g":"then retain them","tr":"fa-amsikūhunna"},{"t":"بِمَعْرُوفٍ","s":[["بِ","P","P|PREF|LEM:ب"],["مَعْرُوفٍ","N","PASS_PCPL|VF:1|ROOT:عرف|LEM:مَعْرُوف|M|INDEF|GEN"]],"g":"with kindness","tr":"bimaʿrūfin"},{"t":"أَوْ","s":[["أَوْ","P","CONJ|LEM:أَو"]],"g":"or","tr":"aw"},{"t":"فَارِقُوهُنَّ","s":[["فَارِقُ","V","IMPV|VF:3|ROOT:فرق|LEM:فارِقُ|2MP"],["و","N","PRON|SUFF|2MP"],["هُنَّ","N","PRON|SUFF|3FP"]],"g":"part with them","tr":"fāriqūhunna"},{"t":"بِمَعْرُوفٍ","s":[["بِ","P","P|PREF|LEM:ب"],["مَعْرُوفٍ","N","PASS_PCPL|VF:1|ROOT:عرف|LEM:مَعْرُوف|M|INDEF|GEN"]],"g":"with kindness","tr":"bimaʿrūfin"},{"t":"وَأَشْهِدُوا۟","s":[["وَ","P","CONJ|PREF|LEM:و"],["أَشْهِدُ","V","IMPV|VF:4|ROOT:شهد|LEM:أَشْهَدَ|2MP"],["وا۟","N","PRON|SUFF|2MP"]],"g":"And take witness","tr":"wa-ashhidū"},{"t":"ذَوَىْ","s":[["ذَوَىْ","N","LEM:ذُو|MD|ACC"]],"g":"two men","tr":"dhaway"},{"t":"عَدْلٍ","s":[["عَدْلٍ","N","ROOT:عدل|LEM:عَدْل|M|INDEF|GEN"]],"g":"just","tr":"ʿadlin"},{"t":"مِّنكُمْ","s":[["مِّن","P","P|LEM:مِن"],["كُمْ","N","PRON|SUFF|2MP"]],"g":"among you","tr":"minkum"},{"t":"وَأَقِيمُوا۟","s":[["وَ","P","CONJ|PREF|LEM:و"],["أَقِيمُ","V","IMPV|VF:4|ROOT:قوم|LEM:أَقامَ|2MP"],["وا۟","N","PRON|SUFF|2MP"]],"g":"and establish","tr":"wa-aqīmū"},{"t":"ٱلشَّهَٰدَةَ","s":[["ٱل","P","DET|PREF|LEM:ال"],["شَّهَٰدَةَ","N","ROOT:شهد