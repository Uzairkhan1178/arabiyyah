{"n":109,"ar":"الكافرون","tl":"Al-Kaafiroon","en":"The Disbelievers","type":"meccan","basmala":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"a":1,"w":[{"t":"قُلْ","s":[["قُلْ","V","IMPV|VF:1|ROOT:قول|LEM:قالَ|2MS"]],"g":"Say","tr":"qul"},{"t":"يَٰٓأَيُّهَا","s":[["يَٰٓ","P","VOC|PREF|LEM:ي"],["أَيُّ","N","ROOT:أيي|LEM:أَيّ|ACC"],["هَا","P","ATT|SUFF|LEM:ه"]],"g":"O","tr":"yāayyuhā"},{"t":"ٱلْكَٰفِرُونَ","s":[["ٱلْ","P","DET|PREF|LEM:ال"],["كَٰفِرُونَ","N","ACT_PCPL|VF:1|ROOT:كفر|LEM:كافِر|MP|NOM"]],"g":"disbelievers","tr":"l-kāfirūna"}],"en":"(1) Say, \"O disbelievers,","ur":"آپ کہہ دیجئے کہ اے کافرو![1]"},{"a":2,"w":[{"t":"لَآ","s":[["لَآ","P","NEG|LEM:لا"]],"g":"Not","tr":"lā"},{"t":"أَعْبُدُ","s":[["أَعْبُدُ","V","IMPF|VF:1|ROOT:عبد|LEM:عَبَدَ|1S|MOOD:IND"]],"g":"I worship","tr":"aʿbudu"},{"t":"مَا","s":[["مَا","N","REL|LEM:ما"]],"g":"what","tr":"mā"},{"t":"تَعْبُدُونَ","s":[["تَعْبُدُ","V","IMPF|VF:1|ROOT:عبد|LEM:عَبَدَ|2MP|MOOD:IND"],["ونَ","N","PRON|SUFF|2MP"]],"g":"you worship","tr":"taʿbudūna"}],"en":"(2) I do not worship what you worship.","ur":"نہ میں عبادت کرتا ہوں اس کی جس کی تم عبادت کرتے ہو."},{"a":3,"w":[{"t":"وَلَآ","s":[["وَ","P","CONJ|PREF|LEM:و"],["لَآ","P","NEG|LEM:لا"]],"g":"And not","tr":"walā"},{"t":"أَنتُمْ","s":[["أَنتُمْ","N","PRON|2MP"]],"g":"you","tr":"antum"},{"t":"عَٰبِدُونَ","s":[["عَٰبِدُونَ","N","ACT_PCPL|VF:1|ROOT:عبد|LEM:عابِد|MP|NOM"]],"g":"(are) worshippers","tr":"ʿābidūna"},{"t":"مَآ","s":[["مَآ","N","REL|LEM:ما"]],"g":"(of) what","tr":"mā"},{"t":"أَعْبُدُ","s":[["أَعْبُدُ","V","IMPF|VF:1|ROOT:عبد|LEM:عَبَدَ|1S|MOOD:IND"]],"g":"I worship","tr":"aʿbudu"}],"en":"(3) Nor are you worshippers of what I worship.","ur":"نہ تم عبادت کرنے والے ہو اس کی جس کی میں عبادت کرتا ہوں."},{"a":4,"w":[{"t":"وَلَآ","s":[["وَ","P","CONJ|PREF|LEM:و"],["لَآ","P","NEG|LEM:لا"]],"g":"And not","tr":"walā"},{"t":"أَنَا۠","s":[["أَنَا۠","N","PRON|1S"]],"g":"I am","tr":"anā"},{"t":"عَابِدٌ","s":[["عَابِدٌ","N","ACT_PCPL|VF:1|ROOT:عبد|LEM:عابِد