{"n":94,"ar":"الشرح","tl":"Ash-Sharh","en":"The Consolation","type":"meccan","basmala":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"a":1,"w":[{"t":"أَلَمْ","s":[["أَ","N","INTG|PREF|LEM:أ"],["لَمْ","P","NEG|LEM:لَم"]],"g":"Have not","tr":"alam"},{"t":"نَشْرَحْ","s":[["نَشْرَحْ","V","IMPF|VF:1|ROOT:شرح|LEM:شَرَحَ|1P|MOOD:JUS"]],"g":"We expanded","tr":"nashraḥ"},{"t":"لَكَ","s":[["لَ","P","P|PREF|LEM:ل"],["كَ","N","PRON|2MS"]],"g":"for you","tr":"laka"},{"t":"صَدْرَكَ","s":[["صَدْرَ","N","ROOT:صدر|LEM:صَدْر|M|ACC"],["كَ","N","PRON|SUFF|2MS"]],"g":"your breast","tr":"ṣadraka"}],"en":"(1) Did We not expand for you, [O Muḥammad], your breast?[1944]","ur":"کیا ہم نے تیرا سینہ نہیں کھول دیا.[1]"},{"a":2,"w":[{"t":"وَوَضَعْنَا","s":[["وَ","P","CONJ|PREF|LEM:و"],["وَضَعْ","V","PERF|VF:1|ROOT:وضع|LEM:وَضَعَ|1P"],["نَا","N","PRON|SUFF|1P"]],"g":"And We removed","tr":"wawaḍaʿnā"},{"t":"عَنكَ","s":[["عَن","P","P|LEM:عَن"],["كَ","N","PRON|SUFF|2MS"]],"g":"from you","tr":"ʿanka"},{"t":"وِزْرَكَ","s":[["وِزْرَ","N","ROOT:وزر|LEM:وِزْر|F|ACC"],["كَ","N","PRON|SUFF|2MS"]],"g":"your burden","tr":"wiz'raka"}],"en":"(2) And We removed from you your burden[1945]","ur":"اور تجھ پر سے تیرا بوجھ ہم نے اتار دیا.[1]"},{"a":3,"w":[{"t":"ٱلَّذِىٓ","s":[["ٱلَّذِىٓ","N","REL|LEM:الَّذِي|MS"]],"g":"Which","tr":"alladhī"},{"t":"أَنقَضَ","s":[["أَنقَضَ","V","PERF|VF:4|ROOT:نقض|LEM:أَنقَضَ|3MS"]],"g":"weighed upon","tr":"anqaḍa"},{"t":"ظَهْرَكَ","s":[["ظَهْرَ","N","ROOT:ظهر|LEM:ظَهْر|M|ACC"],["كَ","N","PRON|SUFF|2MS"]],"g":"your back","tr":"ẓahraka"}],"en":"(3) Which had weighed upon your back","ur":"جس نے تیری پیٹھ توڑ دی تھی."},{"a":4,"w":[{"t":"وَرَفَعْنَا","s":[["وَ","P","CONJ|PREF|LEM:و"],["رَفَعْ","V","PERF|VF:1|ROOT:رفع|LEM:رَفَعَ|1P"],["نَا","N","PRON|SUFF|1P"]],"g":"And We raised high","tr":"warafaʿnā"},{"t":"لَكَ","s":[["لَ","P","P|PREF|LEM:ل"],["كَ","N","PRON|2MS"]],"g":"for you","tr":"laka"},{"t":"ذِكْرَكَ","s":[["ذِكْرَ","N","VN|VF:1|ROOT:ذكر|LEM:ذِكْر|M|ACC"],["كَ","N","PRON|SUFF