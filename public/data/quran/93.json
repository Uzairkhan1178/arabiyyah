{"n":93,"ar":"الضحى","tl":"Ad-Dhuhaa","en":"The Morning Hours","type":"meccan","basmala":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"a":1,"w":[{"t":"وَٱلضُّحَىٰ","s":[["وَ","P","P|PREF|LEM:و"],["ٱل","P","DET|PREF|LEM:ال"],["ضُّحَىٰ","N","ROOT:ضحو|LEM:ضُحًى|M|GEN"]],"g":"By the morning brightness","tr":"wal-ḍuḥā"}],"en":"(1) By the morning brightness","ur":"قسم ہے چاشت کے وقت کی.[1]"},{"a":2,"w":[{"t":"وَٱلَّيْلِ","s":[["وَ","P","CONJ|PREF|LEM:و"],["ٱلَّ","P","DET|PREF|LEM:ال"],["يْلِ","N","ROOT:ليل|LEM:لَيْل|M|GEN"]],"g":"And the night","tr":"wa-al-layli"},{"t":"إِذَا","s":[["إِذَا","N","T|LEM:إِذا"]],"g":"when","tr":"idhā"},{"t":"سَجَىٰ","s":[["سَجَىٰ","V","PERF|VF:1|ROOT:سجو|LEM:سَجَى|3MS"]],"g":"it covers with darkness","tr":"sajā"}],"en":"(2) And [by] the night when it covers with darkness,[1941]","ur":"اور قسم ہے رات کی جب چھا جائے.[1]"},{"a":3,"w":[{"t":"مَا","s":[["مَا","P","NEG|LEM:ما"]],"g":"Not","tr":"mā"},{"t":"وَدَّعَكَ","s":[["وَدَّعَ","V","PERF|VF:2|ROOT:ودع|LEM:وَدَّعَ|3MS"],["كَ","N","PRON|SUFF|2MS"]],"g":"has forsaken you","tr":"waddaʿaka"},{"t":"رَبُّكَ","s":[["رَبُّ","N","ROOT:ربب|LEM:رَبّ|M|NOM"],["كَ","N","PRON|SUFF|2MS"]],"g":"your Lord","tr":"rabbuka"},{"t":"وَمَا","s":[["وَ","P","CONJ|PREF|LEM:و"],["مَا","P","NEG|LEM:ما"]],"g":"and not","tr":"wamā"},{"t":"قَلَىٰ","s":[["قَلَىٰ","V","PERF|VF:1|ROOT:قلي|LEM:قَلَى|3MS"]],"g":"He is displeased","tr":"qalā"}],"en":"(3) Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].","ur":"نہ تو تیرے رب نے تجھے چھوڑا ہے اور نہ وه بیزار ہو گیا ہے.[1]"},{"a":4,"w":[{"t":"وَلَلْـَٔاخِرَةُ","s":[["وَ","P","REM|PREF|LEM:و"],["لَ","P","EMPH|PREF|LEM:ل"],["لْ","P","DET|PREF|LEM:ال"],["ءَاخِرَةُ","N","ROOT:أخر|LEM:آخِر|FS|NOM"]],"g":"And surely the Hereafter","tr":"walalākhiratu"},{"t":"خَيْرٌ","s":[["خَيْرٌ","N","ROOT:خير|LEM:خَيْر|MS|INDEF|NOM"]],"g":"(is) better","tr":"khayrun"},{"t":"لَّكَ","s":[["لَّ","P","P|PREF|LEM:ل"],["كَ","N","PRON|2MS"]],"g":"for you","tr":"laka"},{"t":"مِ