{
  "compilerOptions": {
    "target": "ES2021", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "isolatedModules": true, "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "tests"]
}
